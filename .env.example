# DP Suite — environment variables template.
# Copy to `.env.local` (git-ignored) for local development.
# Never commit real credentials. Never use service_role keys in the frontend.

# Application environment: development | staging | production
VITE_APP_ENV=development

# Supabase — Development / Staging / Production project.
# Use the PUBLISHABLE (anon) key only. Real values are provisioned via
# secure configuration, not this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
